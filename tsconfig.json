{
	"compilerOptions": {
		"target": "ES2023",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"strict": true,
		"erasableSyntaxOnly": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noUncheckedIndexedAccess": true,
		"types": ["node", "bun-types"]
	},
	"include": ["src", "test"]
}
